###############################################################################
# table3_housing_goal_paper.R
#
# Table 3: "Probability of Attaining the Housing Goal"  --  PAPER VERSION
#
#   Panel A. Hypothetical: all wealth in one vehicle, by starting wealth W
#   Panel B. Actual portfolios of respondents short of G, by cryptocurrency held
#
# This script reproduces the table EXACTLY as it appears in the draft.  It is a
# frozen, no-switches version of
#     Code/dr_table_explore/table3_housing_goal.R
# which is the exploratory script (its switches drift as specifications are
# tried).  The upstream Python source of record for the *memo* version of this
# table (G = 103, aspiring homeowners only) is
#     revision_model/andrei_table/{make_tables.py, holdings_analysis.py,
#                                  realized_moments.py}
# and that is Table 1 of goal_vehicles_memo.tex -- a DIFFERENT specification
# from the one printed in the paper.  See "Specification" below.
#
# Input : Code/dr_table_explore/clean_df_for_regs.csv  (semi-processed SKT data)
# Output: console table + LaTeX (dr_random/output/table3_housing_goal.tex)
#
# Base R only; nothing here is simulated, so no seed is needed.
#
# -----------------------------------------------------------------------------
# Specification, and how it differs from the andrei_table memo
# -----------------------------------------------------------------------------
#                            paper Table 3        memo Table 1
#   G (housing goal)         100M KRW             103M KRW
#   sigma_stock              0.20 /yr             0.208 /yr  (FRED realized)
#   sigma_crypto             0.60 /yr             0.669 /yr  (FRED realized)
#   Panel B sample           all respondents      aspiring homeowners
#                            with assets < G      with assets < G
#   Panel B crypto bins      holders only,        includes a "none" column,
#                            cuts at 1, 10, 25M   cuts at 1 and 5M
#   Lotto 6/45               top three tiers      all five tiers
#
# The paper rounds the volatilities to 0.20 and 0.60; realized_moments.py
# computes 0.208 and 0.669 from the FRED series.  That is a deliberate
# difference in the draft, not a bug here, but it is worth a decision before
# the table goes out -- the memo's notes claim realized volatilities.
###############################################################################
rm(list = ls())
## ----------------------------------------------------------------------------
## 0. Paths
## ----------------------------------------------------------------------------
root     <- "/Users/drussel/Harvard University Dropbox/Dominic Russel/gambling"
csv_path <- file.path(root, "Code", "dr_table_explore", "clean_df_for_regs.csv")
out_dir  <- file.path(root, "dr_random", "output")
if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
## ----------------------------------------------------------------------------
## 1. Parameters  (all monetary amounts in MILLIONS of KRW)
##
## Both risky assets are lognormal over the five-year horizon.  Means come from
## the survey (median mean beliefs, the mu-bar calibrated in draft Section 7);
## volatilities are annualized log vols.  Given a five-year gross expected
## return ER and an annual log vol sigma,
##     log R_5 ~ N( log(ER) - (sigma^2 * 5)/2 ,  sigma^2 * 5 ),
## so E[R_5] = ER exactly.  Elicited volatilities are deliberately not used.
## ----------------------------------------------------------------------------
G       <- 100        # housing goal
horizon <- 5          # years, T
r_safe  <- 0.03       # deposit rate on the non-risky part of the portfolio
ER_stock   <- 1.345   # survey median 5-yr mean belief, Korea equity index
ER_crypto  <- 1.446   # survey median 5-yr mean belief, cryptocurrency
sig_stock  <- 0.20    # annualized log vol, Korea equity
sig_crypto <- 0.60    # annualized log vol, cryptocurrency
W_grid      <- c(10, 25, 50, 75)   # Panel A starting-wealth grid
crypto_cuts <- c(1, 10, 25)        # interior cut points for the Panel B bins
# Bins are right-closed -- (0,1], (1,10], (10,25], above 25.  crypto_approx
# takes only the midpoints of the survey's response bins (0.05, 0.3, 0.75,
# 1.75, 3.75, 7.5, 17.5, 37.5, 75, 300), so no respondent sits on a cut point
# and ">" and ">=" select the same people.
## ----------------------------------------------------------------------------
## 2. Lognormal machinery
## ----------------------------------------------------------------------------
log_moments <- function(ER, sigma, years = horizon) {
list(m = log(ER) - (sigma^2 * years) / 2,
s = sigma * sqrt(years))
}
lm_stock  <- log_moments(ER_stock,  sig_stock)
lm_crypto <- log_moments(ER_crypto, sig_crypto)
# P(W * R_T >= G) when all wealth sits in a single lognormal asset.
p_single_asset <- function(W, G, pars) {
if (W <= 0) return(0)
1 - pnorm((log(G / W) - pars$m) / pars$s)
}
## ----------------------------------------------------------------------------
## 3. Lotto 6/45
##
## Prizes are derived from the published rules rather than assumed: 1,000 KRW
## per ticket, 50% of sales to the prize pool, fixed 4th/5th prizes of 50,000
## and 5,000 KRW, and the residual split 75/12.5/12.5 across the top three
## tiers.  Korean lottery tax is 33% above 300M KRW and 22% above 5M KRW.
## All of W is spent on tickets, so reaching G means winning.
##
## The table counts only the top three tiers, which is what reaching a 100M
## goal turns on: the 4th and 5th prizes are 50,000 and 5,000 KRW and can only
## matter in combination with two 2nd-tier wins.  Accumulating them as well
## (set lotto_small_tiers <- TRUE) moves exactly one cell, W = 75M, from 0.9%
## to 1.0%; every other cell is unchanged to the displayed precision.
##
## make_tables.py evaluates the lottery by Monte Carlo (2,000,000 draws).  Here
## the distribution is computed exactly, which removes the only stochastic
## element in the table.
## ----------------------------------------------------------------------------
lotto_small_tiers <- FALSE   # FALSE reproduces the table as printed
lotto_ticket <- 0.001   # millions of KRW per ticket (= 1,000 KRW)
lotto_odds   <- c(1 / 8145060, 1 / 1357510, 1 / 35724, 1 / 733, 1 / 45)
lotto_unit   <- 0.005   # 5,000 KRW: the 5th prize, and a divisor of the 4th
.pool  <- 0.5 * lotto_ticket
.resid <- .pool - 0.05 * lotto_odds[4] - 0.005 * lotto_odds[5]
lotto_prize <- c(0.750 * .resid / lotto_odds[1],
0.125 * .resid / lotto_odds[2],
0.125 * .resid / lotto_odds[3],
0.05, 0.005)
lotto_net <- ifelse(lotto_prize > 300, lotto_prize * 0.67,
ifelse(lotto_prize >   5, lotto_prize * 0.78, lotto_prize))
stopifnot(abs(sum(lotto_prize * lotto_odds) / lotto_ticket - 0.50) < 1e-9)
p_lotto <- function(W, G, small_tiers = lotto_small_tiers) {
n <- as.integer(round(W / lotto_ticket))
# Tiers 1-3 are large and rare: enumerate their counts directly.
K1 <- 2; K2 <- 12; K3 <- 45
p1 <- dbinom(0:K1, n, lotto_odds[1])
p2 <- dbinom(0:K2, n, lotto_odds[2])
p3 <- dbinom(0:K3, n, lotto_odds[3])
if (small_tiers) {
# Tiers 4 and 5 are small and numerous.  In units of 5,000 KRW their
# combined winnings are U = 10*N4 + N5; build its distribution once by
# convolution, then read off tail probabilities.
K4 <- qbinom(1 - 1e-13, n, lotto_odds[4]) + 25
K5 <- qbinom(1 - 1e-13, n, lotto_odds[5]) + 60
p4 <- dbinom(0:K4, n, lotto_odds[4])
p5 <- dbinom(0:K5, n, lotto_odds[5])
u  <- numeric(10 * K4 + K5 + 1)
for (k in 0:K4) {
idx <- (10 * k + 1):(10 * k + K5 + 1)
u[idx] <- u[idx] + p4[k + 1] * p5
}
tv <- c(rev(cumsum(rev(u))), 0)        # tv[j + 1] = P(U >= j)
}
tot <- 0
for (a in 0:K1) for (b in 0:K2) {
base <- lotto_net[1] * a + lotto_net[2] * b
if (base >= G) { tot <- tot + p1[a + 1] * p2[b + 1]; next }
for (cc in 0:K3) {
rem <- G - base - lotto_net[3] * cc
pr  <- if (rem <= 0) 1 else if (!small_tiers) 0 else {
j <- ceiling(rem / lotto_unit - 1e-9)
if (j + 1 <= length(tv)) tv[j + 1] else 0
}
tot <- tot + p1[a + 1] * p2[b + 1] * p3[cc + 1] * pr
}
}
tot
}
## ----------------------------------------------------------------------------
## 4. Panel B machinery: probability of reaching G from a mixed portfolio
##
## holdings_analysis.py evaluates this by Monte Carlo (300,000 independent
## draws of the two shocks).  Here the equity shock is integrated analytically
## and the crypto shock by quadrature on a fine normal grid, which is the same
## object without simulation noise (the two agree to well under 0.05pp).
## ----------------------------------------------------------------------------
z_grid <- seq(-9, 9, length.out = 20001)
z_wt   <- dnorm(z_grid); z_wt <- z_wt / sum(z_wt)
# P(safe_T + stock*R_stock + crypto*R_crypto >= G) for one respondent, where
# safe_T is the terminal value of everything not in the two risky assets (the
# caller compounds it, so the counterfactual can park the former crypto
# position at its own rate).
p_reach_goal <- function(safe_T, stock, crypto, G) {
if (crypto <= 0) {                       # closed form in the equity shock
need <- G - safe_T
if (need <= 0)  return(1)
if (stock <= 0) return(0)
return(1 - pnorm((log(need / stock) - lm_stock$m) / lm_stock$s))
}
need <- G - safe_T - crypto * exp(lm_crypto$m + lm_crypto$s * z_grid)
if (stock <= 0) {
p_cond <- as.numeric(need <= 0)
} else {
p_cond <- ifelse(
need <= 0, 1,
1 - pnorm((log(pmax(need, 1e-12) / stock) - lm_stock$m) / lm_stock$s)
)
}
sum(p_cond * z_wt)
}
## ----------------------------------------------------------------------------
## 5. Survey data
##
## The three wealth questions (net assets, stocks, crypto) are separately
## binned, so reported holdings need not fit inside reported assets.  Stock and
## crypto are rescaled proportionally to fit inside net assets; the remainder
## earns the deposit rate.
## ----------------------------------------------------------------------------
df <- read.csv(csv_path, stringsAsFactors = FALSE)
wealth_vars <- c("assets_approx", "crypto_approx", "stock_approx")
complete_w  <- complete.cases(df[, wealth_vars])
## ----------------------------------------------------------------------------
## 6. Panel builders
## ----------------------------------------------------------------------------
make_panelA <- function(G) {
out <- rbind(
`Korea equity index` = sapply(W_grid, p_single_asset, G = G, pars = lm_stock),
`Cryptocurrency`     = sapply(W_grid, p_single_asset, G = G, pars = lm_crypto),
`Lotto 6/45`         = sapply(W_grid, p_lotto, G = G)
) * 100
colnames(out) <- paste0(W_grid, "M")
out
}
make_panelB <- function(G, cuts = crypto_cuts) {
stopifnot(length(cuts) == 3)   # labels below are frozen to the printed bins
# All respondents with assets below G who hold cryptocurrency.
s <- df[which(complete_w & df$assets_approx < G), , drop = FALSE]
n_short <- nrow(s)
s <- s[s$crypto_approx > 0, , drop = FALSE]
labs <- c("0-1M", "1-10M", "10-25M", ">25M")
s$crypto_bin <- cut(s$crypto_approx, breaks = c(0, cuts, Inf), labels = labs)
tot_risky <- s$stock_approx + s$crypto_approx
rescale   <- pmin(1, s$assets_approx / ifelse(tot_risky > 0, tot_risky, 1))
stock     <- s$stock_approx  * rescale
crypto    <- s$crypto_approx * rescale
safe      <- pmax(s$assets_approx - stock - crypto, 0)
# (a) portfolio as actually held; (b) crypto sold and held at the deposit rate
safe_T     <- safe * (1 + r_safe)^horizon
p_held     <- mapply(p_reach_goal, safe_T, stock, crypto, MoreArgs = list(G = G))
p_nocrypto <- mapply(p_reach_goal, safe_T + crypto * (1 + r_safe)^horizon,
stock, rep(0, nrow(s)), MoreArgs = list(G = G))
tab <- rbind(tapply(p_held,     s$crypto_bin, mean),
tapply(p_nocrypto, s$crypto_bin, mean)) * 100
rownames(tab) <- c("P(reach G) as held", "P(reach G) without cryptocurrency")
list(tab = tab, n = as.vector(table(s$crypto_bin)), labels = labs,
N = nrow(s), n_short = n_short,
misfit = mean((s$crypto_approx + s$stock_approx) > s$assets_approx))
}
## ----------------------------------------------------------------------------
## 7. Build the table
## ----------------------------------------------------------------------------
panelA <- make_panelA(G)
away   <- G / W_grid                       # how far each W is from the goal
B      <- make_panelB(G)
panelB <- B$tab
cat(sprintf("Respondents with assets below G=%gM: %d | of whom hold crypto: %d\n",
G, B$n_short, B$N))
cat(sprintf("Crypto+stocks exceed net assets for %.0f%% of them (holdings rescaled).\n",
100 * B$misfit))
## ----------------------------------------------------------------------------
## 8. Console output
## ----------------------------------------------------------------------------
pct   <- function(x) formatC(x, format = "f", digits = 1, width = 9)
lbl_w <- 36
rule  <- strrep("-", lbl_w + 1 + 9 * length(W_grid))
cat("\n")
cat("Table 3: Probability of Attaining the Housing Goal   (G =", G, "M KRW,",
horizon, "years)\n")
cat(rule, "\n")
cat("A. Hypothetical: all wealth in one vehicle, by starting wealth W\n")
cat(formatC("", width = lbl_w),
paste(formatC(colnames(panelA), width = 9), collapse = ""), "\n")
cat(formatC("", width = lbl_w),
paste(formatC(c(sprintf("(%gx away)", away[1]), sprintf("(%gx)", round(away[-1], 1))),
width = 9), collapse = ""), "\n")
for (i in seq_len(nrow(panelA)))
cat(formatC(rownames(panelA)[i], width = lbl_w, flag = "-"),
paste(pct(panelA[i, ]), collapse = ""), "\n")
cat(rule, "\n")
cat("B. Actual portfolios of respondents short of G, by cryptocurrency held\n")
cat(formatC("", width = lbl_w),
paste(formatC(B$labels, width = 9), collapse = ""), "\n")
cat(formatC("", width = lbl_w),
paste(formatC(sprintf("(n=%d)", B$n), width = 9), collapse = ""), "\n")
for (i in seq_len(nrow(panelB)))
cat(formatC(rownames(panelB)[i], width = lbl_w, flag = "-"),
paste(pct(panelB[i, ]), collapse = ""), "\n")
cat(rule, "\n\n")
## ----------------------------------------------------------------------------
## 9. LaTeX output  (matches the table as typeset in the draft)
## ----------------------------------------------------------------------------
f1  <- function(x) sprintf("%.1f\\%%", x)
ncols <- length(W_grid)
row_tex <- function(label, cells) paste0(label, " & ", paste(cells, collapse = " & "), "\\\\")
tex <- c(
"\\begin{table}[!htbp]",
" \\caption{Probability of Attaining the Housing Goal}",
" \\centering",
" \\footnotesize",
paste0("\\begin{tabular}{l", strrep("c", ncols), "}"),
"\\toprule",
paste0("\\multicolumn{", ncols + 1,
"}{l}{\\textit{A. Hypothetical: all wealth in one vehicle, by starting wealth $W$}}\\\\"),
row_tex("", sprintf("%dM", W_grid)),
row_tex("", c(sprintf("\\textit{(%g$\\times$ away)}", away[1]),
sprintf("\\textit{(%g$\\times$)}", round(away[-1], 1)))),
"\\midrule",
row_tex("Korea equity index", f1(panelA[1, ])),
row_tex("Cryptocurrency",     f1(panelA[2, ])),
row_tex("Lotto 6/45",         f1(panelA[3, ])),
"\\midrule",
paste0("\\multicolumn{", ncols + 1,
"}{l}{\\textit{B. Actual portfolios of respondents short of $G$, by cryptocurrency held}}\\\\"),
row_tex("", c("0--1M", "1--10M", "10--25M", "$>$25M")),
row_tex("", sprintf("\\textit{($n$=%d)}", B$n)),
"\\midrule",
row_tex("$P$(reach $G$) as held",                f1(panelB[1, ])),
row_tex("$P$(reach $G$) without cryptocurrency", f1(panelB[2, ])),
"\\bottomrule",
"\\end{tabular}",
"    \\begin{minipage}{0.98\\textwidth}\\footnotesize{",
"        \\vspace{0.25em}",
paste0("        \\textit{Notes:} Probability that terminal wealth reaches $G=", G,
"$M KRW within five years. Panel A commits all liquid wealth to one vehicle ",
"for five years; both risky assets are lognormal with survey median expected ",
"returns and realized volatilities. Panel B evaluates the probability of ",
"reaching $G$ for the sample of survey respondents with assets below $G$ at ",
"their own reported holdings.}"),
"    \\end{minipage}",
"    \\label{tab:goal_vehicles}",
"\\end{table}"
)
tex_path <- file.path(out_dir, "table3_housing_goal.tex")
writeLines(tex, tex_path)
cat("LaTeX written to:", tex_path, "\n")
## ----------------------------------------------------------------------------
## 10. Regression check against the table as printed in the draft
## ----------------------------------------------------------------------------
printed <- list(
panelA = matrix(c(0.0, 0.4, 13.3, 41.9,
1.7, 7.6, 18.1, 27.1,
0.1, 0.3,  0.6,  0.9),
nrow = 3, byrow = TRUE),
panelB = matrix(c(4.0, 9.1, 16.9, 24.3,
3.9, 6.5,  9.5, 11.6),
nrow = 2, byrow = TRUE),
n      = c(210, 110, 17, 20)
)
check <- function(what, got, want) {
ok <- all(abs(round(got, 1) - want) < 1e-9)
cat(sprintf("%-10s %s\n", what, if (ok) "PASS" else "FAIL"))
if (!ok) {
cat("  got : ", paste(sprintf("%.2f", got),  collapse = " "), "\n")
cat("  want: ", paste(sprintf("%.1f", want), collapse = " "), "\n")
}
ok
}
cat("\nRegression check vs. the table as printed\n", strrep("-", 42), "\n", sep = "")
ok <- c(
check("Panel A",  as.vector(panelA),  as.vector(printed$panelA)),
check("Panel B",  as.vector(panelB),  as.vector(printed$panelB)),
check("Cell n's", B$n,                printed$n)
)
cat(if (all(ok)) "\nTable 3 reproduces exactly.\n" else "\nSome cells differ -- see above.\n")
rule
